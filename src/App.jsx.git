        else if (tStr.includes('[?꾨씪??')) broadRegion = '?꾨씪??;
        else if (tStr.includes('[異⑹껌??')) broadRegion = '異⑹껌??;
        else if (tStr.includes('[媛뺤썝/?쒖＜]')) broadRegion = '媛뺤썝/?쒖＜';
        else {
          const fullSearchText = `${p.address || ''} ${locName} ${p.cityName || ''}`;
          if (fullSearchText.includes('遺??) || fullSearchText.includes('?援?) || fullSearchText.includes('?몄궛') || fullSearchText.includes('寃쎌긽') || fullSearchText.includes('寃쎈궓') || fullSearchText.includes('寃쎈턿') || fullSearchText.includes('李쎌썝') || fullSearchText.includes('?ы빆') || fullSearchText.includes('源??)) broadRegion = '寃쎌긽??;
          else if (fullSearchText.includes('?쒖슱') || fullSearchText.includes('媛뺣궓') || fullSearchText.includes('?띾?') || fullSearchText.includes('?좎떎') || fullSearchText.includes('?깆닔') || fullSearchText.includes('?쒖큹') || fullSearchText.includes('?곷벑??) || fullSearchText.includes('?좊┝') || fullSearchText.includes('嫄대?')) broadRegion = '?쒖슱';
          else if (fullSearchText.includes('寃쎄린') || fullSearchText.includes('?몄쿇') || fullSearchText.includes('遺泥?) || fullSearchText.includes('?섏썝') || fullSearchText.includes('?덉뼇') || fullSearchText.includes('?섏젙遺') || fullSearchText.includes('遺꾨떦') || fullSearchText.includes('?쇱궛')) broadRegion = '寃쎄린/?몄쿇';
          else if (fullSearchText.includes('愿묒＜') || fullSearchText.includes('?꾨씪') || fullSearchText.includes('?꾨궓') || fullSearchText.includes('?꾨턿') || fullSearchText.includes('?꾩＜') || fullSearchText.includes('紐⑺룷') || fullSearchText.includes('?ъ닔') || fullSearchText.includes('?쒖쿇')) broadRegion = '?꾨씪??;
          else if (fullSearchText.includes('???) || fullSearchText.includes('異⑸궓') || fullSearchText.includes('異⑸턿') || fullSearchText.includes('異⑹껌') || fullSearchText.includes('?몄쥌') || fullSearchText.includes('泥쒖븞') || fullSearchText.includes('泥?＜')) broadRegion = '異⑹껌??;
          else if (fullSearchText.includes('媛뺤썝') || fullSearchText.includes('?쒖＜') || fullSearchText.includes('異섏쿇') || fullSearchText.includes('?먯＜') || fullSearchText.includes('?쒓???)) broadRegion = '媛뺤썝/?쒖＜';
        } 
        
        const barInfo = findBarByName(locName);
        const locationNameEn = barInfo?.name_en || locName;
        const broadRegionEn = REGION_MAP_EN[broadRegion] || broadRegion;
